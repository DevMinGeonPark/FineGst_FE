{
  "expo": {
    "name": "(주) 화인지에스티",
    "slug": "finegstApp",
    "version": "10.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finegstapp",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/98a9da2b-eba2-4045-ae34-cd3f861b4c4c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "shop.kt-online.www.finegstApp",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "kakaotalk",
          "kakaoplus",
          "kakaostory",
          "tel",
          "mailto",
          "http",
          "https"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.finegst.mshop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "image": "./assets/splash-ios.png",
            "backgroundColor": "#000000"
          },
          "android": {
            "width": 200,
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98a9da2b-eba2-4045-ae34-cd3f861b4c4c"
      }
    }
  }
}
